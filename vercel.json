{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/services/",
      "destination": "/services/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/faq/",
      "destination": "/faq/index.html"
    },
    {
      "source": "/products",
      "destination": "/products/index.html"
    },
    {
      "source": "/products/",
      "destination": "/products/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/about-us/index.html"
    },
    {
      "source": "/about-us/",
      "destination": "/about-us/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
